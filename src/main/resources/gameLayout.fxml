<?import com.comp2042.view.GameOverPanel?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:controller="com.comp2042.view.GuiController"
           xmlns:fx="http://javafx.com/fxml">

    <!-- Game area -->
    <StackPane alignment="CENTER">
        <BorderPane styleClass="gameBoard" fx:id="gameBoard">
            <center>
                <StackPane alignment="TOP_LEFT">
                    <GridPane fx:id="gamePanel" hgap="1" vgap="1"/>
                    <Pane fx:id="brickPanel"/>
                </StackPane>
            </center>
        </BorderPane>
    </StackPane>

    <!-- notifications-->
    <Group fx:id="groupNotification">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
        </VBox>
    </Group>

    <!-- score -->
    <HBox alignment="TOP_LEFT" StackPane.alignment="TOP_LEFT" spacing="10">
        <Label fx:id="scoreLabel" text="0" styleClass="scoreClass" />
    </HBox>

    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>

</StackPane>
