<?import com.comp2042.view.GameOverPanel?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import java.net.URL?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.Region?>

<StackPane fx:controller="com.comp2042.view.GuiController"
           fx:id="rootPane"
           xmlns:fx="http://javafx.com/fxml">

    <!-- Game area -->
    <VBox alignment="TOP_CENTER" spacing="5">

        <!-- top HUD: score + level + lines -->
        <HBox alignment="CENTER"
              spacing="12"
              translateY="-6"
              style="-fx-padding: 8 0 0 0;">
            <!-- score -->
            <Label text="SCORE:"
                   styleClass="hudLabel"/>

            <Label fx:id="scoreLabel"
                   text="0"
                   styleClass="hudValue"/>

            <!-- level -->
            <Label text="LEVEL:"
                   styleClass="hudLabel"/>

            <Label fx:id="levelLabel"
                   text="1"
                   styleClass="hudValue"/>

            <!-- lines -->
            <Label text="LINES:"
                   styleClass="hudLabel"/>

            <Label fx:id="linesLabel"
                   text="0"
                   styleClass="hudValue"/>

            <!-- spacer to push anything else to the right if needed later -->
            <!-- (no Region here anymore so the HUD can stay centered) -->
        </HBox>

        <StackPane alignment="CENTER">
            <BorderPane styleClass="gameBoard" fx:id="gameBoard">
                <center>
                    <StackPane alignment="TOP_LEFT">
                        <GridPane fx:id="gamePanel" hgap="1" vgap="1"/>
                        <Pane fx:id="ghostPanel"/>
                        <Pane fx:id="brickPanel"/>
                    </StackPane>
                </center>
            </BorderPane>
        </StackPane>
    </VBox>

    <!-- notifications -->
    <Group fx:id="groupNotification">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
        </VBox>
    </Group>

    <!-- pause overlay -->
    <StackPane fx:id="pauseOverlay"
               visible="false"
               mouseTransparent="false">
        <VBox alignment="CENTER"
              spacing="15"
              styleClass="pausePanel">

            <Label text="PAUSED"
                   styleClass="pauseTitle"/>

            <Button text="Resume"
                    onAction="#handleResume"
                    styleClass="ipad-dark-grey"/>

            <Button text="New Game"
                    onAction="#handleNewGameFromPause"
                    styleClass="ipad-dark-grey"/>

            <Button text="Exit"
                    onAction="#handleExit"
                    styleClass="ipad-dark-grey"/>

            <!-- audio controls -->
            <Label text="Audio"
                   styleClass="pauseSubtitle"/>

            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="musicToggleButton"
                        text="Music: On"
                        onAction="#handleToggleMusic"
                        styleClass="ipad-dark-grey"/>

                <Button fx:id="sfxToggleButton"
                        text="SFX: On"
                        onAction="#handleToggleSfx"
                        styleClass="ipad-dark-grey"/>
            </HBox>

            <Slider fx:id="volumeSlider"
                    min="0.0"
                    max="1.0"
                    value="0.7"
                    blockIncrement="0.1"
                    styleClass="volumeSlider"/>

            <Label text="Controls"
                   styleClass="pauseSubtitle"/>

            <Label text="Move: ← → / A D or mouse"
                   styleClass="pauseControls"/>
            <Label text="Rotate: ↑ / W / scroll wheel"
                   styleClass="pauseControls"/>
            <Label text="Soft drop: ↓ / S"
                   styleClass="pauseControls"/>
            <Label text="Hard drop: Space / click / middle click"
                   styleClass="pauseControls"/>
        </VBox>
    </StackPane>

    <!-- game over overlay -->
    <StackPane fx:id="gameOverOverlay"
               visible="false"
               mouseTransparent="false">
        <VBox alignment="CENTER"
              spacing="15"
              styleClass="pausePanel">

            <Label text="GAME OVER"
                   styleClass="pauseTitle"/>

            <Label text="Play again?"
                   styleClass="pauseSubtitle"/>

            <HBox alignment="CENTER" spacing="10">
                <Button text="Play Again"
                        onAction="#handleGameOverPlayAgain"
                        styleClass="ipad-dark-grey"/>

                <Button text="Exit"
                        onAction="#handleExit"
                        styleClass="ipad-dark-grey"/>
            </HBox>
        </VBox>
    </StackPane>

    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>

</StackPane>
