<?import com.comp2042.view.GameOverPanel?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import java.net.URL?>

<StackPane fx:controller="com.comp2042.view.GuiController"
           fx:id="rootPane"
           xmlns:fx="http://javafx.com/fxml">

    <!-- Game area -->
    <StackPane alignment="CENTER">
        <BorderPane styleClass="gameBoard" fx:id="gameBoard">
            <center>
                <StackPane alignment="TOP_LEFT">
                    <GridPane fx:id="gamePanel" hgap="1" vgap="1"/>
                    <Pane fx:id="ghostPanel"/>
                    <Pane fx:id="brickPanel"/>
                </StackPane>
            </center>
        </BorderPane>
    </StackPane>

    <!-- notifications -->
    <Group fx:id="groupNotification">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
        </VBox>
    </Group>

    <!-- top HUD; score in fixed top left corner always -->
    <HBox fx:id="scoreContainer"
          layoutX="10"
          layoutY="10"
          spacing="10">
        <Label fx:id="scoreLabel"
               text="0"
               styleClass="scoreClass" />
    </HBox>

    <!-- pause overlay -->
    <StackPane fx:id="pauseOverlay"
               visible="false"
               mouseTransparent="false">
        <VBox alignment="CENTER"
              spacing="15"
              styleClass="pausePanel">

            <Label text="PAUSED"
                   styleClass="pauseTitle"/>

            <Button text="Resume"
                    onAction="#handleResume"
                    styleClass="ipad-dark-grey"/>

            <Button text="New Game"
                    onAction="#handleNewGameFromPause"
                    styleClass="ipad-dark-grey"/>

            <Button text="Exit"
                    onAction="#handleExit"
                    styleClass="ipad-dark-grey"/>

            <Label text="Controls"
                   styleClass="pauseSubtitle"/>

            <Label text="Move: ← → / A D or mouse"
                   styleClass="pauseControls"/>
            <Label text="Rotate: ↑ / W / scroll wheel"
                   styleClass="pauseControls"/>
            <Label text="Soft drop: ↓ / S"
                   styleClass="pauseControls"/>
            <Label text="Hard drop: Space / click / middle click"
                   styleClass="pauseControls"/>
        </VBox>
    </StackPane>

    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>

</StackPane>
