<?import com.comp2042.view.GameOverPanel?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import java.net.URL?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.Region?>

<StackPane fx:controller="com.comp2042.view.GuiController"
           fx:id="rootPane"
           xmlns:fx="http://javafx.com/fxml">

    <!-- Game area -->
    <VBox alignment="TOP_CENTER"
          spacing="5"
          style="-fx-padding: 12 0 0 0;">  <!-- pushes everything down a bit -->
        <StackPane alignment="CENTER">
            <BorderPane styleClass="gameBoard" fx:id="gameBoard">
                <center>
                    <HBox spacing="24" alignment="CENTER_LEFT">

                        <!-- Left side: title + main playfield -->
                        <StackPane>
                            <!-- yellow TETRIS title above the grid -->
                            <Label text="TETRIS"
                                   StackPane.alignment="TOP_CENTER"
                                   styleClass="hudLabel"
                                   style="-fx-font-size: 24;"/>

                            <!-- grid and bricks, nudged down slightly -->
                            <StackPane alignment="TOP_LEFT" translateY="28">
                                <GridPane fx:id="gamePanel" hgap="1" vgap="1"/>
                                <Pane fx:id="ghostPanel"/>
                                <Pane fx:id="brickPanel"/>
                            </StackPane>
                        </StackPane>

                        <!-- Right-hand column: HUD + next piece -->
                        <VBox alignment="TOP_CENTER" spacing="10">

                            <!-- HUD stacked vertically, bigger and centred -->
                            <VBox alignment="CENTER" spacing="10" translateY="80">
                                <HBox alignment="CENTER" spacing="10">
                                    <Label text="SCORE:"
                                           styleClass="hudLabel"
                                           style="-fx-font-size: 22;"/>
                                    <Label fx:id="scoreLabel"
                                           text="0"
                                           styleClass="hudValue"
                                           style="-fx-font-size: 22;"/>
                                </HBox>

                                <HBox alignment="CENTER" spacing="10">
                                    <Label text="LEVEL:"
                                           styleClass="hudLabel"
                                           style="-fx-font-size: 22;"/>
                                    <Label fx:id="levelLabel"
                                           text="1"
                                           styleClass="hudValue"
                                           style="-fx-font-size: 22;"/>
                                </HBox>

                                <HBox alignment="CENTER" spacing="10">
                                    <Label text="LINES:"
                                           styleClass="hudLabel"
                                           style="-fx-font-size: 22;"/>
                                    <Label fx:id="linesLabel"
                                           text="0"
                                           styleClass="hudValue"
                                           style="-fx-font-size: 22;"/>
                                </HBox>
                            </VBox>

                            <!-- spacer pushes NEXT section towards vertical centre -->
                            <Region VBox.vgrow="ALWAYS"/>

                            <!-- NEXT section kept tight and centred -->
                            <VBox alignment="CENTER" spacing="8">
                                <Label text="NEXT PIECE"
                                       styleClass="pauseSubtitle"/>

                                <StackPane alignment="CENTER"
                                           prefWidth="140" minWidth="140" maxWidth="140"
                                           prefHeight="140" minHeight="140" maxHeight="140"
                                           style="-fx-background-color: #111111;
                                                  -fx-padding: 8;
                                                  -fx-border-color: #444444;
                                                  -fx-border-width: 1;">
                                    <GridPane fx:id="nextPiecePanel"
                                              hgap="2" vgap="2"
                                              alignment="CENTER"/>
                                </StackPane>
                            </VBox>

                            <!-- optional bottom spacer to keep NEXT really centred -->
                            <Region VBox.vgrow="ALWAYS"/>

                        </VBox>
                    </HBox>
                </center>
            </BorderPane>
        </StackPane>
    </VBox>

    <!-- notifications -->
    <Group fx:id="groupNotification">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
        </VBox>
    </Group>

    <!-- pause overlay -->
    <StackPane fx:id="pauseOverlay"
               visible="false"
               mouseTransparent="false">
        <VBox alignment="CENTER"
              spacing="15"
              styleClass="pausePanel">

            <Label text="PAUSED"
                   styleClass="pauseTitle"/>

            <Button text="Resume"
                    onAction="#handleResume"
                    styleClass="ipad-dark-grey"/>

            <Button text="New Game"
                    onAction="#handleNewGameFromPause"
                    styleClass="ipad-dark-grey"/>

            <Button text="Exit"
                    onAction="#handleExit"
                    styleClass="ipad-dark-grey"/>

            <!-- audio controls -->
            <Label text="Audio"
                   styleClass="pauseSubtitle"/>

            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="musicToggleButton"
                        text="Music: On"
                        onAction="#handleToggleMusic"
                        styleClass="ipad-dark-grey"/>

                <Button
                        text="SFX: On"
                        onAction="#handleToggleSfx"
                        styleClass="ipad-dark-grey"/>
            </HBox>

            <Slider fx:id="volumeSlider"
                    min="0.0"
                    max="1.0"
                    value="0.7"
                    blockIncrement="0.1"
                    styleClass="volumeSlider"/>

            <Label text="Controls"
                   styleClass="pauseSubtitle"/>

            <Label text="Move: ← → / A D or mouse"
                   styleClass="pauseControls"/>
            <Label text="Rotate: ↑ / W / scroll wheel"
                   styleClass="pauseControls"/>
            <Label text="Soft drop: ↓ / S"
                   styleClass="pauseControls"/>
            <Label text="Hard drop: Space / click / middle click"
                   styleClass="pauseControls"/>
        </VBox>
    </StackPane>

    <!-- game over overlay -->
    <StackPane fx:id="gameOverOverlay"
               visible="false"
               mouseTransparent="false">
        <VBox alignment="CENTER"
              spacing="15"
              styleClass="pausePanel">

            <Label text="GAME OVER"
                   styleClass="pauseTitle"/>

            <Label text="Play again?"
                   styleClass="pauseSubtitle"/>

            <HBox alignment="CENTER" spacing="10">
                <Button text="Play Again"
                        onAction="#handleGameOverPlayAgain"
                        styleClass="ipad-dark-grey"/>

                <Button text="Exit"
                        onAction="#handleExit"
                        styleClass="ipad-dark-grey"/>
            </HBox>
        </VBox>
    </StackPane>

    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>

</StackPane>
